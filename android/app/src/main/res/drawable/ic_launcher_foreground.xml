<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft cyan ambient radial glow behind island pill -->
    <path
        android:pathData="M 54,26 A 28,28 0 1 0 54,82 A 28,28 0 1 0 54,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="28"
                android:type="radial">
                <item android:color="#3338BDF8" android:offset="0.0" />
                <item android:color="#120EA5E9" android:offset="0.6" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Island Pill Outer Border / Subtle Highlight -->
    <path
        android:pathData="M 39,43 L 69,43 A 11,11 0 0 1 80,54 A 11,11 0 0 1 69,65 L 39,65 A 11,11 0 0 1 28,54 A 11,11 0 0 1 39,43 Z"
        android:strokeWidth="1.2"
        android:strokeColor="#4D38BDF8">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="43"
                android:endX="80"
                android:endY="65"
                android:type="linear">
                <item android:color="#1A263D" android:offset="0.0" />
                <item android:color="#0D1524" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central Glowing Signal Mark (Orb + Core) -->
    <path
        android:pathData="M 54,49 A 5,5 0 1 0 54,59 A 5,5 0 1 0 54,49 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="5"
                android:type="radial">
                <item android:color="#E0F2FE" android:offset="0.0" />
                <item android:color="#38BDF8" android:offset="0.75" />
                <item android:color="#0284C7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:pathData="M 54,52 A 2,2 0 1 0 54,56 A 2,2 0 1 0 54,52 Z"
        android:fillColor="#FFFFFF" />

    <!-- Left Connection Dots -->
    <path
        android:pathData="M 44.5,52.5 A 1.5,1.5 0 1 0 44.5,55.5 A 1.5,1.5 0 1 0 44.5,52.5 Z"
        android:fillColor="#7DD3FC" />
    <path
        android:pathData="M 37.5,52.75 A 1.25,1.25 0 1 0 37.5,55.25 A 1.25,1.25 0 1 0 37.5,52.75 Z"
        android:fillColor="#38BDF8" />

    <!-- Right Connection Dots -->
    <path
        android:pathData="M 63.5,52.5 A 1.5,1.5 0 1 0 63.5,55.5 A 1.5,1.5 0 1 0 63.5,52.5 Z"
        android:fillColor="#7DD3FC" />
    <path
        android:pathData="M 70.5,52.75 A 1.25,1.25 0 1 0 70.5,55.25 A 1.25,1.25 0 1 0 70.5,52.75 Z"
        android:fillColor="#38BDF8" />

</vector>
